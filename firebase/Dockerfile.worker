# Cloud Run Job "supervisorly-scan-worker" — runs ONE scan job (JOB_ID env) to
# completion (plan §3.6). Create the job (see README.md for the full deploy order):
#
#   gcloud run jobs create supervisorly-scan-worker --source . --region <REGION> \
#     --tasks 1 --max-retries 1 --task-timeout 6h
#
# (--source . builds from a file named Dockerfile — copy this file to Dockerfile in
# a scratch dir together with requirements.txt, main.py, _core.py and worker.py.)
FROM python:3.11-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Headless Chromium for the server-side render rung (D-073). A measured run had 52 of 52
# professors `blocked` because the only page on record was an ORCID profile — public,
# robots-allowed, and a JavaScript application our HTTP reader cannot execute.
#
# This is the expensive line in the image (~400 MB with the system libs Chromium needs), and
# it is why the worker build is slower than the Functions one. `--with-deps` installs those
# libs; without it Chromium is present and refuses to start, which fails at RUN time rather
# than silently at scan time.
#
# If this layer is ever dropped, nothing breaks: `render.py` reports itself unavailable and
# every page takes the path it took before (D-068 fail-closed). Slower is not the same as
# broken, and the scan still finishes.
#
# The libraries are installed EXPLICITLY rather than with `playwright install --with-deps`.
# That flag does not support Debian, which this image is: it falls back to Ubuntu 20.04
# package names ("BEWARE: your OS is not officially supported by Playwright") and the build
# dies on `ttf-unifont` and `ttf-ubuntu-font-family`, which do not exist in Debian's repos.
# The list below is Chromium's actual runtime closure on bookworm; fonts-liberation is the
# Debian font package that replaces the two Ubuntu ones.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
      libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 \
      libpango-1.0-0 libcairo2 libasound2 libatspi2.0-0 libx11-6 libxcb1 libxext6 \
      fonts-liberation \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir playwright==1.49.1 \
    && playwright install chromium

COPY main.py _core.py worker.py ./

# one job execution = one scan; JOB_ID is injected per run by the Functions wrapper
CMD ["python", "worker.py"]
