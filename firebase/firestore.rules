rules_version = '2';

// Supervisorly web build (plan §7 step 7): ALL writes go through the Admin SDK
// (the Functions wrappers and the Cloud Run worker bypass these rules entirely).
// Clients can only ever GET one scan_jobs doc by its id — the unguessable id IS
// the access token (D-069(b)) — and can never list.
service cloud.firestore {
  match /databases/{database}/documents {
    match /scan_jobs/{jobId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }
    match /expand_cache/{doc} {
      allow read, write: if false;
    }
    match /throttle/{doc} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
